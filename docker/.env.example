# ANTAREJA NMS — konfigurasi deployment
# Salin otomatis ke docker/.env oleh "./antareja.sh install" (password diisi acak).
# JANGAN commit docker/.env ke git.

# Versi
ANTAREJA_TAG=0.8.0
LIBRENMS_VERSION=26.10.2
GO2RTC_VERSION=1.9.9

# Umum
TZ=Asia/Jakarta
PHP_MEMORY_LIMIT=512M

# Aktifkan bila VM memakai IPv6 (true/false)
LISTEN_IPV6=false

# Subnet jaringan internal Docker (ubah bila bentrok dengan jaringan tambang)
DOCKER_SUBNET=172.30.250.0/24

# Port yang dibuka di VM (hanya Nginx)
HTTP_PORT=80
HTTPS_PORT=443

# Nama host / IP yang dipakai pengguna untuk membuka ANTAREJA (untuk sertifikat TLS)
SERVER_NAME=antareja.local

# Database (diisi otomatis saat install)
DB_NAME=antareja
DB_USER=antareja
DB_PASSWORD=__GENERATE__

# Community SNMP untuk snmpd internal container (bukan untuk perangkat jaringan)
SNMP_COMMUNITY_LOCAL=__GENERATE__

# Backup
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# Build image lewat proxy (opsional). CA proxy TLS-inspection: simpan di docker/build-ca.crt
BUILD_HTTPS_PROXY=
BUILD_HTTP_PROXY=
DOCKER_BUILD_NETWORK=default

# Asisten AI (opsional, butuh internet ke api.anthropic.com). Kosongkan ANTAREJA_AI_KEY untuk menonaktifkan.
# Kunci API tidak pernah dikirim ke browser.
ANTAREJA_AI_KEY=
ANTAREJA_AI_MODEL=claude-opus-5-5
